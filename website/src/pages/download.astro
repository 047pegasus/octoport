---
import Layout from '../layouts/Layout.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { RELEASES_URL, INSTALL_CMD, INSTALL_PS1_CMD } from '../lib/site';

const platforms = [
  {
    name: 'macOS',
    note: 'Apple silicon and Intel',
    cmd: INSTALL_CMD,
    icon: 'M12 6.5c-1.2 0-2 .7-3 .7s-1.9-.7-3.1-.7C4.3 6.5 3 8 3 10.6c0 2.7 2 6.4 3.4 6.4.8 0 1.2-.6 2.3-.6s1.4.6 2.3.6c1.5 0 3.3-3.4 3.3-5.4-2-.7-2.3-3.6.7-4.4-.7-1-1.9-1.5-3-1.5m.4-3c.1 1.2-.9 2.6-2.3 2.5-.2-1.1 1-2.5 2.3-2.5',
  },
  {
    name: 'Linux',
    note: 'x86_64 and aarch64',
    cmd: INSTALL_CMD,
    icon: 'M12 3c2 0 3 1.7 3 4 0 1.8.6 2.6 1.4 3.8.9 1.3 1.6 2.4 1.6 4.2 0 3-2.4 5-6 5s-6-2-6-5c0-1.8.7-2.9 1.6-4.2C8.4 9.6 9 8.8 9 7c0-2.3 1-4 3-4Zm-1.5 5.2h.01m2.99 0h.01M11 11.5c.6.5 1.4.5 2 0',
  },
  {
    name: 'Windows',
    note: 'PowerShell 5.1 or later',
    cmd: INSTALL_PS1_CMD,
    icon: 'M3 5.5 10 4.6v6.6H3zM11.5 4.4 21 3v8.2h-9.5zM3 12.8h7v6.6l-7-.9zm8.5 0H21V21l-9.5-1.4z',
  },
];
---

<Layout
  title="Download"
  description="Get OctoPort for macOS, Linux or Windows — the command-line client and the desktop app. One file, nothing else to install, and every release is signed."
  current="/download"
>
  <section class="wrap py-16 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-primary">Download</p>
      <h1 class="mt-2 font-display text-4xl tracking-tight sm:text-5xl">Get OctoPort</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        One file, nothing else to install. Pick your platform, sign in, and share a port about a
        minute later.
      </p>
    </div>

    <!-- CLI -->
    <h2 class="mt-16 font-display text-2xl tracking-tight">Command line</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {
        platforms.map((p) => (
          <div class="reveal flex flex-col rounded-2xl border border-border/70 bg-card p-6">
            <span class="grid h-10 w-10 place-items-center rounded-xl text-primary" style="background: var(--primary-soft)" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <path d={p.icon} />
              </svg>
            </span>
            <h3 class="mt-4 font-semibold">{p.name}</h3>
            <p class="mt-1 text-sm text-muted-foreground">{p.note}</p>
            <div class="relative mt-4">
              <pre data-copy={p.cmd} class="overflow-x-auto rounded-lg bg-muted/70 px-3 py-2.5 pr-10 font-mono text-[11.5px] leading-relaxed">{p.cmd}</pre>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Desktop -->
    <h2 class="mt-14 font-display text-2xl tracking-tight">Desktop app</h2>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
      The same thing with a window: sign in, open tunnels, pause and resume them, and watch traffic
      as it arrives. Installers for all three platforms are attached to every release.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a
        href={RELEASES_URL}
        target="_blank"
        rel="noreferrer noopener"
        class="inline-flex h-11 items-center rounded-xl bg-primary px-6 text-sm font-semibold text-primary-foreground transition hover:opacity-90 active:scale-[0.98]"
      >
        All downloads
      </a>
      <a
        href="/docs#install"
        class="inline-flex h-11 items-center rounded-xl border border-border bg-card px-6 text-sm font-semibold transition hover:bg-accent active:scale-[0.98]"
      >
        Installation guide
      </a>
    </div>
    <p class="mt-4 text-sm text-muted-foreground">
      macOS: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[0.85em]">.dmg</code> ·
      Windows: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[0.85em]">.msi</code> ·
      Linux: <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[0.85em]">.AppImage</code> and
      <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[0.85em]">.deb</code>
    </p>
  </section>

  <section class="wrap border-t border-border/70 py-14">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-2xl tracking-tight">After installing</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Sign in once, then open a tunnel whenever you need one:
        </p>
        <CodeBlock code={'octoport login\noctoport expose 3000'} />
      </div>

      <div>
        <h2 class="font-display text-2xl tracking-tight">Check what you downloaded</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          Every release ships a checksum file and a signature produced by the public build, so you
          can confirm nothing was altered on the way to you.
        </p>
        <CodeBlock code={'sha256sum -c SHA256SUMS --ignore-missing'} />
        <p class="text-sm leading-relaxed text-muted-foreground">
          Full steps are in <a class="text-primary underline underline-offset-4" href="/docs#verify">the docs</a>.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { initCopyButtons } from '../scripts/copy-code';
  initCopyButtons();
</script>
