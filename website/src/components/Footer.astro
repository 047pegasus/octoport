---
import Logo from './Logo.astro';
import { GITHUB_URL, RELEASES_URL } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border/70">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo />
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">
        Give any port on your machine a public HTTPS link — in one command.
        Open source, and free while in beta.
      </p>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Product</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a class="text-muted-foreground transition-colors hover:text-foreground" href="/docs">Documentation</a></li>
        <li><a class="text-muted-foreground transition-colors hover:text-foreground" href="/download">Download</a></li>
        <li><a class="text-muted-foreground transition-colors hover:text-foreground" href="/docs#cli">Command reference</a></li>
      </ul>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Project</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a class="text-muted-foreground transition-colors hover:text-foreground" href={RELEASES_URL} target="_blank" rel="noreferrer noopener">Releases</a>
        </li>
        <li>
          <a class="text-muted-foreground transition-colors hover:text-foreground" href={`${GITHUB_URL}/issues`} target="_blank" rel="noreferrer noopener">Issues</a>
        </li>
        <li><a class="text-muted-foreground transition-colors hover:text-foreground" href="/docs#security">Security</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap border-t border-border/70 py-6 text-sm text-muted-foreground">
    <p>© {year} OctoPort</p>
  </div>
</footer>
