---
import { NAV, GITHUB_URL } from '../lib/site';

interface Props {
  current?: string;
  /**
   * Overlay the bar on top of the page rather than sitting above it. Used on
   * the landing page so the hero background runs the full viewport height,
   * behind the nav. While overlaid and un-scrolled the bar is a transparent
   * glass panel over the hero; once scrolled past it, it picks up the normal
   * page surface.
   */
  overlay?: boolean;
}
const { current = '', overlay = false } = Astro.props;
---

<header id="site-nav" class="site-nav" data-overlay={overlay ? 'true' : 'false'}>
  <div class="nav-pill">
    <a href="/" class="nav-brand rounded-full text-[1.0625rem]" aria-label="OctoPort — home">
      {/* A small octopus, drawn in currentColor so it follows the nav's
          text colour in every theme and over the landing backdrop. */}
      <svg class="nav-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M12 3.2c3.1 0 5.6 2.4 5.6 5.4 0 1.3-.3 2.1-.3 2.9 0 .8.5 1.2 1.1 1.2.5 0 .9-.3 1.1-.8"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
        <path
          d="M6.4 8.6c0-3 2.5-5.4 5.6-5.4M6.4 8.6c0 1.3.3 2.1.3 2.9 0 .8-.5 1.2-1.1 1.2-.5 0-.9-.3-1.1-.8"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
        <path
          d="M9.1 11.9c0 1.6-.6 2.6-.6 4 0 .9.5 1.5 1.2 1.5.8 0 1.2-.6 1.2-1.6M14.9 11.9c0 1.6.6 2.6.6 4 0 .9-.5 1.5-1.2 1.5-.8 0-1.2-.6-1.2-1.6"
          stroke="currentColor"
          stroke-width="1.7"
          stroke-linecap="round"
        />
        <circle cx="9.8" cy="8.4" r="1.05" fill="currentColor" />
        <circle cx="14.2" cy="8.4" r="1.05" fill="currentColor" />
      </svg>
      OctoPort
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        NAV.map((l) => (
          <a
            href={l.href}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'noreferrer noopener' : undefined}
            aria-current={current === l.href ? 'page' : undefined}
            class:list={[
              'nav-link rounded-lg px-3.5 py-2 text-sm font-medium transition-colors',
              current === l.href ? 'is-current' : '',
            ]}
            style={current === l.href ? 'background: var(--primary-soft)' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={GITHUB_URL}
        target="_blank"
        rel="noreferrer noopener"
        class="nav-github nav-link hidden sm:inline-flex"
        aria-label="OctoPort on GitHub (opens in a new tab)"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        GitHub
      </a>

      <button
        id="theme-toggle"
        type="button"
        class="nav-link grid h-9 w-9 place-items-center rounded-lg transition-colors"
        aria-label="Toggle colour theme"
      >
        <svg
          class="hidden h-[18px] w-[18px] dark:block"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"
          ></path>
        </svg>
        <svg
          class="h-[18px] w-[18px] dark:hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8"></path>
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="nav-link grid h-9 w-9 place-items-center rounded-lg transition-colors md:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    hidden
    class="mobile-nav border-t border-border/70 px-5 py-3 backdrop-blur-xl md:hidden"
    aria-label="Mobile"
  >
    {
      NAV.map((l) => (
        <a
          href={l.href}
          target={l.external ? '_blank' : undefined}
          rel={l.external ? 'noreferrer noopener' : undefined}
          class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium"
        >
          {l.label}
        </a>
      ))
    }
    <a
      href={GITHUB_URL}
      target="_blank"
      rel="noreferrer noopener"
      class="nav-link block rounded-lg px-3 py-2.5 text-sm font-medium"
    >
      GitHub
    </a>
  </nav>
</header>

<script>
  // Theme toggle — the initial class is set by an inline script in <head>,
  // so this only handles user-driven changes.
  const root = document.documentElement;
  let fadeTimer: number;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = !root.classList.contains('dark');

    // Cross-fade the colour swap. Custom properties do not interpolate, so a
    // short transition is enabled on the affected properties for the length
    // of the change, then removed so ordinary hovers stay snappy.
    root.classList.add('theme-switching');
    window.clearTimeout(fadeTimer);
    fadeTimer = window.setTimeout(() => root.classList.remove('theme-switching'), 480);

    root.classList.toggle('dark', dark);
    try {
      localStorage.setItem('octoport-theme', dark ? 'dark' : 'light');
    } catch {
      /* storage blocked — the toggle still works for this page view */
    }
  });

  // Overlay bar: transparent while it sits over the hero, glass once the
  // page has scrolled past it.
  const nav = document.getElementById('site-nav');
  if (nav?.dataset.overlay === 'true') {
    const sync = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }

  // Mobile menu
  const menuBtn = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-nav');
  menuBtn?.addEventListener('click', () => {
    const open = menu?.hasAttribute('hidden');
    if (open) menu?.removeAttribute('hidden');
    else menu?.setAttribute('hidden', '');
    menuBtn.setAttribute('aria-expanded', String(!!open));
  });
</script>
