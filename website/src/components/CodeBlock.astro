---
/**
 * Static code block with a copy-to-clipboard affordance.
 * The button is injected by script, so no-JS visitors just see the code.
 */
interface Props {
  code: string;
  label?: string;
  class?: string;
}
const { code, label, class: cls = '' } = Astro.props;
---

<figure class={`group relative my-4 ${cls}`}>
  {
    label && (
      <figcaption class="mb-1.5 font-mono text-[11px] uppercase tracking-widest text-muted-foreground">
        {label}
      </figcaption>
    )
  }
  <pre
    class="overflow-x-auto rounded-xl border border-border/80 bg-muted/50 py-4 pl-4 pr-12 font-mono text-[13px] leading-relaxed"
data-copy={code}><code>{code}</code></pre>
</figure>

<script>
  import { initCopyButtons } from '../scripts/copy-code';
  initCopyButtons();
</script>
