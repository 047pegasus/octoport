---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SiteBackground from '../components/SiteBackground.astro';

interface Props {
  title: string;
  description: string;
  current?: string;
  /**
   * Path to an OpenGraph image, relative to the site root. Defaults to the
   * brand mark. Social cards copy the full path as an absolute URL.
   */
  ogImage?: string;
  /**
   * Landing treatment: a fixed animated backdrop behind the whole page, a
   * glass nav pill over it, and the deep-surface token scope.
   */
  overlayNav?: boolean;
}
const { title, description, current, ogImage = '/brand/icon-512.png', overlayNav = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" class="dark no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · OctoPort</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content="OctoPort" />
    <meta property="og:title" content={`${title} · OctoPort`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:url" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="OctoPort brand mark — a square with an octagonal O, dark on a light background and light on a dark one." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · OctoPort`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="OctoPort brand mark — a square with an octagonal O, dark on a light background and light on a dark one." />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#08080c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbfd" media="(prefers-color-scheme: light)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Instrument+Serif&family=JetBrains+Mono:wght@400;500&family=Poppins:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Applied before first paint so the correct theme renders immediately.
      // Dark is the default; an explicit stored choice always wins.
      (() => {
        const root = document.documentElement;
        root.classList.remove('no-js');
        try {
          root.classList.toggle('dark', localStorage.getItem('octoport-theme') !== 'light');
        } catch {
          root.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class:list={["flex min-h-screen flex-col", overlayNav && "landing landing-shell"]}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-card focus:px-4 focus:py-2 focus:text-sm focus:shadow-lg"
    >
      Skip to content
    </a>

    {overlayNav && <SiteBackground />}

    <Nav current={current} overlay={overlayNav} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />

    <script>
      // Reveal the hairline scrollbar only while the page is actually being
      // scrolled, then fade it back out.
      let scrollIdle: number;
      addEventListener(
        'scroll',
        () => {
          document.documentElement.classList.add('is-scrolling');
          clearTimeout(scrollIdle);
          scrollIdle = window.setTimeout(
            () => document.documentElement.classList.remove('is-scrolling'),
            900,
          );
        },
        { passive: true },
      );
    </script>

    <script>
      // Scroll reveal. Elements start hidden only once JS confirms it can
      // reveal them, so a failed script can never leave the page blank.
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (items.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                (e.target as HTMLElement).classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
