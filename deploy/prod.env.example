# Production environment for the octoport control plane on one domain
# (itanishq.space), behind Traefik + Cloudflare Tunnel.
#
# Copy to .env next to the control plane binary (or the docker-compose) and
# adjust secrets/addresses. This file pairs with deploy/traefik/dynamic-octoport.yml.

# --- identity / domains ---
# The wildcard (*.itanishq.space) flows through your Cloudflare Tunnel to the
# global Traefik (deploy/traefik/dynamic-octoport.yml), which routes by Host.
# Random tunnel URLs become:  https://<random>.itanishq.space
#
# RAW TCP tunnels ALSO ride the Cloudflare Tunnel (see
# deploy/cloudflared-config.example.yml): the ingress rule
#   *.tcp.itanishq.space -> tcp://octoport-control-plane:8091
# makes cloudflared open a plain TCP connection to the proxy, so the client's
# TLS stream (SNI = <sub>.tcp.itanishq.space) flows through untouched and the
# proxy terminates TLS + routes by SNI. No inbound port is needed, so this
# keeps working with a DYNAMIC home IP. DNS is a PROXIED CNAME:
#   OCTOPORT_TCP_BASE -> *.tcp.itanishq.space  CNAME -> <tunnel>.cfargotunnel.com
# Clients connect with:  cloudflared access tcp --hostname <sub>.tcp.itanishq.space ...
#
# PORT CHOICE — the client-visible port only matters for the DIRECT fallback
# path (LAN / clients without cloudflared): the ISP router only offers fixed
# "protocol" presets, so use the HTTPS (443) preset — forward WAN TCP 443 ->
# this host's :443, and the compose file maps host :443 -> container :8091.
# Because the proxy terminates TLS and routes by SNI, every TCP tunnel then
# looks like ordinary HTTPS on :443 (Cloudflare-ToS friendly). Only change
# OCTOPORT_TCP_PORT if 443 is already taken (then pick another preset port, e.g.
# 2049/NFS or 6667/IRC, and forward that instead). The direct path needs a
# DNS-only A/AAAA record + a DDNS updater because the home IP is dynamic.
OCTOPORT_BASE_DOMAIN=itanishq.space
OCTOPORT_PUBLIC_BASE=https://itanishq.space   # full public base URL incl scheme+host (used to build tunnel URLs)
OCTOPORT_TCP_BASE=tcp.itanishq.space          # domain raw TCP tunnels are served under (DNS-only wildcard)
OCTOPORT_TCP_PORT=443                         # port clients dial for raw TCP tunnels (router HTTPS preset)
OCTOPORT_TCP_TLS=true                         # terminate TLS on the TCP proxy (encrypts all TCP tunnel traffic)
OCTOPORT_TCP_TLS_CERT=/certs/cert.pem         # wildcard cert for *.tcp.itanishq.space (mounted from deploy/certs)
OCTOPORT_TCP_TLS_KEY=/certs/key.pem
OCTOPORT_ENV=production
OCTOPORT_LOG_LEVEL=info

# --- reserved subdomains ---
# Labels that belong to OTHER services on itanishq.space (or to the platform
# itself) and must NEVER be handed out as tunnel subdomains. Keep the exact
# hostnames of every app you run on this domain here so Traefik's exact-host
# routing for them is never shadowed by a tunnel URL.
OCTOPORT_RESERVED_SUBDOMAINS=www,octoport,octoport-control-plane,portainer,grafana,traefik,checkmate,heartbeat,mail,blog,www-itanishq

# --- listeners (internal; Traefik fronts them) ---
OCTOPORT_API_ADDR=:8080
OCTOPORT_AGENT_WS_ADDR=:8081
OCTOPORT_PUBLIC_ADDR=:8090
OCTOPORT_PUBLIC_TCP_ADDR=:8091

# --- data plane ---
# YugabyteDB (Postgres-wire) inside the compose network:
OCTOPORT_DATABASE_URL=postgres://octoport:octoport@yugabytedb:5433/octoport?sslmode=disable
OCTOPORT_DB_POOL_MAX=32
OCTOPORT_DB_SHARDS=8
OCTOPORT_VALKEY_ADDRS=valkey:6379

# --- security ---
# REQUIRED in production. Generate with:  openssl rand -base64 48
OCTOPORT_JWT_SECRET=CHANGE-ME-openssl-rand-base64-48
OCTOPORT_JWT_TTL=24h
OCTOPORT_PASSWORD_MIN_LENGTH=8
OCTOPORT_RATE_LIMIT_PER_MINUTE=120

# --- GitHub OAuth sign-in (optional) ---
# Create an OAuth App at https://github.com/settings/developers with the
# "Authorization callback URL" set EXACTLY (no trailing slash) to:
#   https://octoport-control-plane.itanishq.space/auth/github/callback
# The value below must match it exactly, minus the /auth/github/callback suffix.
# Leave the client secret unset to disable GitHub sign-in entirely.
#OCTOPORT_GITHUB_CLIENT_ID=Ov23liNzLuoMNaNpic6Z
#OCTOPORT_GITHUB_CLIENT_SECRET=fc0e9b645c4acae57747a0d00ad63bd439c09100
#OCTOPORT_GITHUB_OAUTH_BASE=https://github.com
#OCTOPORT_GITHUB_API_BASE=https://api.github.com
#OCTOPORT_OAUTH_REDIRECT_BASE=https://octoport-control-plane.itanishq.space
#OCTOPORT_OAUTH_ATTEMPT_TTL=10m
#OCTOPORT_OAUTH_EXCHANGE_TTL=5m

# --- plans / limits ---
OCTOPORT_MAX_TUNNELS_PER_USER=5
OCTOPORT_TUNNEL_IDLE_TIMEOUT=5m
OCTOPORT_RANDOM_DOMAIN_CHARS=8

# --- agent traffic ---
OCTOPORT_MAX_FRAME_SIZE=1048576
OCTOPORT_MAX_STREAMS_PER_AGENT=64
OCTOPORT_READ_TIMEOUT=30s
OCTOPORT_WRITE_TIMEOUT=30s
OCTOPORT_PROXY_TIMEOUT=30s
