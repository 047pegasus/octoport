# =============================================================================
# OctoPort website — static Astro build served by nginx.
#
# Build context is the repo root:
#     docker build -f deploy/Dockerfile.website -t octoport-website .
# =============================================================================

FROM node:22-alpine AS builder

WORKDIR /src

# Install from the lockfile first so this layer caches across content changes.
COPY website/package.json website/package-lock.json ./
RUN npm ci

COPY website/ ./
RUN npm run build

# ------------------------------------------------------------------ runtime --
FROM nginx:1.27-alpine

# The site is fully static; this config adds sensible caching and the security
# headers Cloudflare does not set for us.
COPY deploy/nginx-website.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/dist /usr/share/nginx/html

EXPOSE 80
